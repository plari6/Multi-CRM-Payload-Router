# ---------------------------------------------------------------
# Multi-CRM Payload Router: copy to .env and fill in what you use.
# ---------------------------------------------------------------

# --- Routing ----------------------------------------------------
HIGH_BUDGET_THRESHOLD=10000          # USD; leads at or above this are "high budget"
HIGH_BUDGET_DESTINATION=salesforce   # salesforce | zoho
LOW_BUDGET_DESTINATION=sheets        # sheets | airtable
DRY_RUN=false                        # true = never call external APIs

# --- Gemini (reads budgets written as text, e.g. "mid five figures") ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=10                        # requests/minute; keep under your quota
GEMINI_ENABLED=true

# --- Salesforce (OAuth2: client credentials, or refresh token if set) ---
SALESFORCE_INSTANCE_URL=https://yourcompany.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_API_VERSION=v61.0
SALESFORCE_BUDGET_FIELD=             # optional custom field, e.g. Budget__c

# --- Zoho CRM (OAuth2 refresh token) ---------------------------
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com   # .eu / .in / .com.au for other data centers
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BUDGET_FIELD=                   # optional custom field API name

# --- Google Sheets (service account) ---------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Leads!A1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Airtable ---------------------------------------------------
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads

# --- Webhook server --------------------------------------------
PORT=3000
WEBHOOK_SECRET=                      # set this in production (HMAC-SHA256 signatures)

# --- Delivery ---------------------------------------------------
DESTINATION_RPM=60                   # max requests/minute per destination
MAX_RETRIES=3
CONCURRENCY=3
DEAD_LETTER_FILE=output/dead_letter.jsonl
# BUDGET_FX_RATES={"EUR":1.08,"GBP":1.27}   # optional: override currency rates
